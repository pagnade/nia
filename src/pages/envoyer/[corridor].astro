---
import Landing from '../../components/Landing.astro';
import providers from '../../data/providers.json';
import quotes from '../../data/quotes.json';
import ecb from '../../data/ecb.json';
import { compare, corridors } from '../../lib/compare.js';
import { pageMeta } from '../../lib/seo.js';

export function getStaticPaths() {
  return corridors().map((c) => ({ params: { corridor: c.slug }, props: c }));
}
const { origin, dest } = Astro.props;
const { best } = compare({ providers, quotes: quotes.quotes, ecb, ccy: origin.ccy, dest: dest.code, origin: origin.code, amount: 100 });
const { title, description } = pageMeta(origin, dest, best);
---
<Landing originCode={origin.code} destCode={dest.code} title={title} description={description} />
