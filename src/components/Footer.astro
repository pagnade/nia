---
import Logo from './Logo.astro';

const { localAnchors = false } = Astro.props;
---
<footer class="footer">
  <div class="footer__inner wrap">
    <div class="footer__about">
      <Logo />
      <span>Comparateur indépendant des transferts vers le Cameroun et la Côte d'Ivoire. Taux indicatifs, non contractuels : vérifiez le montant final chez le service avant d'envoyer.</span>
    </div>
    <nav aria-label="Pied de page">
      <a href="/comment-ca-marche">Comment ça marche</a>
      <a href={localAnchors ? '#faq' : '/#faq'}>FAQ</a>
      <a href="/mentions-legales">Mentions légales</a>
      <a href="/confidentialite">Confidentialité</a>
    </nav>
  </div>
</footer>
