---
import Logo from './Logo.astro';
import { T, PATHS } from '../lib/i18n.js';

const { localAnchors = false, lang = 'fr' } = Astro.props;
const t = T[lang];
const P = PATHS[lang];
const at = localAnchors ? '' : (lang === 'fr' ? '/' : '/en');
---
<footer class="footer">
  <div class="footer__inner wrap">
    <div class="footer__about">
      <Logo href={P.home} label={t.nav.home} />
      <span>{t.footer.about}</span>
    </div>
    <nav aria-label={t.footer.label}>
      <a href={P.how}>{t.nav.how}</a>
      <a href={`${at}#faq`}>{t.nav.faq}</a>
      <a href={P.legal}>{t.footer.legal}</a>
      <a href={P.privacy}>{t.footer.privacy}</a>
    </nav>
  </div>
</footer>
