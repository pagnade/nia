---
import Base from '../layouts/Base.astro';
import providers from '../data/providers.json';
import quotes from '../data/quotes.json';
import ecb from '../data/ecb.json';
import { compare, corridorSlug, midRate, CCY, DESTS, OPS, ORIGINS } from '../lib/compare.js';
import { renderResults, fmt } from '../lib/view.js';

interface Props {
  originCode: string;
  destCode: string;
  title: string;
  description: string;
  isHome?: boolean;
}
const { originCode, destCode, title, description, isHome = false } = Astro.props;
const origin = ORIGINS.find((o) => o.code === originCode)!;
const dest = DESTS[destCode];
const ccy = origin.ccy;
const AMOUNT = 100;
const res = compare({ providers, quotes: quotes.quotes, ecb, ccy, dest: destCode, amount: AMOUNT });
const observed = new Date(quotes.observedAt).toLocaleString('fr-FR', { dateStyle: 'long', timeStyle: 'short', timeZone: 'Europe/Paris' });
const ecbDate = new Date(ecb.date).toLocaleDateString('fr-FR', { dateStyle: 'long' });
const popular = [
  ['FR', 'CM', 100], ['FR', 'CI', 100], ['BE', 'CM', 250], ['GB', 'CI', 200],
  ['US', 'CI', 300], ['CA', 'CM', 300], ['FR', 'CM', 500], ['BE', 'CI', 250]
].map(([o, d, a]) => {
  const oo = ORIGINS.find((x) => x.code === o)!;
  const dd = DESTS[d as string];
  return { href: `/envoyer/${corridorSlug(oo, dd)}?montant=${a}`, title: `${oo.name} → ${dd.name}`, sub: `${a} ${oo.ccy} vers ${dd.fcfa}` };
});
const faq = [
  ["Comment nia gagne-t-il de l'argent ?", "Par des liens affiliés : certains services nous versent une commission quand vous envoyez via nia. Vous ne payez rien de plus, et le classement reste calculé uniquement sur le montant reçu (ou le critère que vous choisissez)."],
  ['Comment le montant reçu est-il calculé ?', "(Montant envoyé − frais) × taux appliqué par le service. Le coût total ajoute frais et écart avec la parité officielle, en % du montant, comme le fait la Banque mondiale."],
  ['Pourquoi certains taux dépassent 655,957 FCFA pour 1 € ?', "Le franc CFA est arrimé à l'euro : 1 € vaut toujours 655,957 FCFA. Un taux plus élevé est une promotion payée par le service, souvent limitée au premier envoi et plafonnée. Activez « Premier envoi » pour la voir, « Envoi habituel » pour la suite."],
  ['Puis-je envoyer directement depuis nia ?', "Non. Le bouton « Envoyer avec… » vous emmène chez le service, où vous finalisez l'envoi. nia ne détient jamais vos fonds."],
  ['Les taux sont-ils à jour ?', "Chaque relevé est daté en haut du classement. Le montant final est celui que le service affiche au moment de l'envoi : vérifiez-le toujours avant de payer."]
];
const clientData = { providers, quotes: quotes.quotes, ecb, ccy, dest: destCode };
---
<Base title={title} description={description} localAnchors>
  <section slot="hero" class="hero wrap" id="top">
    <div class="hero__copy">
      <div class="pill-kicker"><span class="dots" aria-hidden="true"><i></i><i></i></span>Afrique subsaharienne</div>
      {isHome
        ? <h1>Même envoi, <span class="hl">pas le même montant reçu&nbsp;!</span></h1>
        : <h1>{origin.name} → {dest.name}&nbsp;: <span class="hl">qui donne le plus&nbsp;?</span></h1>}
      <p class="hero__lead">Comparez ce que votre famille reçoit vraiment en francs CFA, frais inclus, selon le service et le portefeuille de réception.</p>
      <ul class="bullets">
        <li>Filtre par portefeuille : MTN MoMo, Orange Money, Wave, Moov</li>
        <li>Offres de bienvenue séparées du taux habituel</li>
        <li>Chaque taux daté, chaque lien affilié signalé</li>
      </ul>
    </div>

    <div class="widget" role="group" aria-label="Paramètres de comparaison" id="comparateur">
      <div class="route">
        <div class="route__card route__from">
          <span class="route__label">De</span>
          <div class="route__val">
            <span class="ccy-badge" aria-hidden="true">{CCY[ccy].sym}</span>
            <span class="route__country"><strong>{origin.name}</strong><span>{ccy} · {CCY[ccy].name}</span></span>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="color:#5B3DD6;flex:0 0 18px"><path d="M6 9l6 6 6-6"></path></svg>
          </div>
          <span class="route__hint">Changer de pays</span>
          <select id="from" aria-label="Pays d'envoi" data-from>
            {ORIGINS.map((o) => <option value={`/envoyer/${corridorSlug(o, dest)}`} selected={o.code === originCode}>{o.name} · {o.ccy}</option>)}
          </select>
        </div>
        <div class="route__link" aria-hidden="true"><svg><use href="#nia-mark"></use></svg></div>
        <div class="route__card">
          <span class="route__label" id="tolbl">Vers</span>
          <nav class="route__dests" aria-labelledby="tolbl">
            {Object.values(DESTS).map((d) => (
              <a href={`/envoyer/${corridorSlug(origin, d)}`} aria-current={d.code === destCode ? 'page' : undefined} data-keep-query>
                <span>{d.name}</span><small>{d.fcfa}</small>
              </a>
            ))}
          </nav>
        </div>
      </div>

      <label class="field-label" for="amount">J'envoie</label>
      <div class="amount">
        <input id="amount" type="number" min="0" step="1" inputmode="decimal" value={AMOUNT} data-amount>
        <span>{ccy}</span>
      </div>
      <div class="chips-row quick-row" role="group" aria-label="Montants rapides">
        {[100, 250, 500, 1000].map((v) => <button type="button" class="opt opt--grow" data-quick={v} aria-pressed={v === AMOUNT ? 'true' : 'false'}>{v} {ccy}</button>)}
      </div>

      <span class="field-label" id="oplbl">Votre proche reçoit sur</span>
      <div class="chips-row" role="group" aria-labelledby="oplbl">
        {['all', ...dest.ops].map((o) => (
          <button type="button" class="opt" data-op={o} aria-pressed={o === 'all' ? 'true' : 'false'} disabled={o !== 'all' && res.counts[o] === 0}>{o === 'all' ? 'Tous' : OPS[o]}<small>{res.counts[o]}</small></button>
        ))}
      </div>

      <span class="field-label" id="kindlbl">Type d'envoi</span>
      <div class="seg" role="group" aria-labelledby="kindlbl">
        <button type="button" data-kind="usual" aria-pressed="true">Envoi habituel</button>
        <button type="button" data-kind="first" aria-pressed="false">Premier envoi</button>
      </div>

      <a href="#classement" class="cta-main">
        <strong data-count>Voir les {res.total} offres</strong>
        <span data-best>jusqu'à {res.best ? `${fmt(res.best.received)} ${dest.fcfa}` : '—'} reçus</span>
      </a>
    </div>
  </section>

  <section class="section wrap" id="classement">
    <p class="sr-only" role="status" data-status></p>
    <div class="ranking-head">
      <div>
        <div class="eyebrow">Classement</div>
        <h2 data-heading>{origin.name} → {dest.name} · {AMOUNT} {ccy}</h2>
        <div class="ranking-meta">
          <span data-meta>{res.total} services · tous portefeuilles · envoi habituel</span>
          <span>Taux relevés le {observed}{quotes.sample ? ' — valeurs d\'exemple' : ''}</span>
        </div>
      </div>
      <div class="seg seg--round" role="group" aria-label="Trier les autres offres par">
        <button type="button" data-sort="received" aria-pressed="true">Montant reçu</button>
        <button type="button" data-sort="fee" aria-pressed="false">Frais</button>
        <button type="button" data-sort="speed" aria-pressed="false">Délai</button>
      </div>
    </div>
    <div data-results set:html={renderResults(res)} />
    <p class="note">Coût total = frais + écart avec la parité officielle, en % du montant (méthode Banque mondiale ; moyenne mondiale 6,49 % au T1 2025, objectif ONU ≤ 3 %). Les boutons ↗ sont des liens affiliés. Couverture vérifiée pour Taptap Send et LemFi (centres d'aide, 21/10/2026).</p>
  </section>

  <section class="section section--tint" id="taux">
    <div class="wrap ref">
      <div class="ref__copy">
        <div class="eyebrow">Taux de référence</div>
        <h2>1 € = 655,957 FCFA. Toujours.</h2>
        <p>XAF (BEAC, Cameroun) et XOF (BCEAO, Côte d'Ivoire) sont arrimés à l'euro. Depuis l'euro, la différence entre services n'est donc pas le marché : c'est la marge de chacun. Depuis la livre, le dollar ou le dollar canadien, le taux suit en plus l'euro.</p>
      </div>
      <div class="table-box">
        <table>
          <caption class="sr-only">Taux de référence vers le franc CFA</caption>
          <thead><tr><th scope="col">Pays</th>{['EUR', 'GBP', 'USD', 'CAD'].map((c) => <th scope="col">1 {c}</th>)}</tr></thead>
          <tbody>
            {Object.values(DESTS).map((d) => (
              <tr>
                <th scope="row">{d.name} <small>· {d.fcfa}</small></th>
                {['EUR', 'GBP', 'USD', 'CAD'].map((c) => <td>{fmt(midRate(ecb, c), c === 'EUR' ? 3 : 2)}</td>)}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
    <p class="note wrap">Parité BEAC / BCEAO croisée avec les taux de référence de la BCE du {ecbDate}, mis à jour automatiquement chaque jour ouvré.</p>
  </section>

  <section class="section wrap" id="transparence">
    <div class="eyebrow">Transparence</div>
    <h2 class="h2">Comment nia fonctionne</h2>
    <p class="lead">Un comparateur ne vaut que par sa neutralité. Voici tout ce qu'il faut savoir, sans astérisque.</p>
    <div class="cards">
      <div class="card"><div class="num">1</div><h3>Par montant reçu, rien d'autre</h3><p>(Montant − frais) × taux appliqué. Vous pouvez aussi trier par frais ou par délai. Aucun service ne peut payer pour monter.</p></div>
      <div class="card"><div class="num">2</div><h3>Des liens affiliés, signalés</h3><p>Certains services nous versent une commission quand vous envoyez via nos liens. Vous ne payez pas plus. Un service sans accord avec nous reste classé à sa place.</p></div>
      <div class="card"><div class="num">3</div><h3>Vérifiez l'agrément vous‑même</h3><p>nia ne détient jamais votre argent. Avant d'envoyer, vérifiez que le service est agréé (ACPR en France, ou autorité d'un autre pays de l'UE / du Royaume‑Uni).</p>
        <div class="btn-row"><a class="link-btn" href="https://www.regafi.fr" target="_blank" rel="noopener">REGAFI (ACPR)</a><a class="link-btn" href="https://register.fca.org.uk" target="_blank" rel="noopener">Registre FCA</a></div>
      </div>
    </div>
    <p class="note"><a href="/comment-ca-marche">Méthode complète, partenaires et agréments →</a></p>
  </section>

  <section class="wrap" style="padding-bottom:72px" id="couloirs">
    <h2 class="h2" style="font-size:24px;margin-bottom:16px">Couloirs populaires</h2>
    <div class="corridors">
      {popular.map((c) => <a href={c.href}><strong>{c.title}</strong><span>{c.sub}</span></a>)}
    </div>
  </section>

  <section class="section section--tint" id="faq">
    <div class="wrap faq">
      <h2 class="h2" style="margin-bottom:20px">Questions fréquentes</h2>
      {faq.map(([q, a], i) => <details open={i === 0}><summary>{q}</summary><p>{a}</p></details>)}
    </div>
  </section>

  <script type="application/json" id="nia-data" set:html={JSON.stringify(clientData)}></script>
</Base>

<script>
  import { compare, OPS } from '../lib/compare.js';
  import { renderResults, fmt } from '../lib/view.js';

  const data = JSON.parse(document.getElementById('nia-data')!.textContent!);
  const $ = <T extends Element>(s: string) => document.querySelector<T>(s)!;
  const $$ = (s: string) => Array.from(document.querySelectorAll<HTMLElement>(s));
  const params = new URLSearchParams(location.search);
  // Les paramètres d'adresse sont saisis par n'importe qui : on ne garde que des valeurs valides.
  const urlAmount = Number(params.get('montant'));
  const state = {
    amount: Number.isFinite(urlAmount) && urlAmount > 0 ? Math.min(urlAmount, 1_000_000) : 100,
    op: params.get('reception') || 'all',
    kind: params.get('envoi') === 'premier' ? 'first' : 'usual',
    sort: ['received', 'fee', 'speed'].includes(params.get('tri') || '') ? params.get('tri')! : 'received'
  };
  const amountInput = $<HTMLInputElement>('[data-amount]');

  function syncUrl() {
    const p = new URLSearchParams();
    if (state.amount !== 100) p.set('montant', String(state.amount));
    if (state.op !== 'all') p.set('reception', state.op);
    if (state.kind === 'first') p.set('envoi', 'premier');
    if (state.sort !== 'received') p.set('tri', state.sort);
    const q = p.toString();
    history.replaceState(null, '', location.pathname + (q ? `?${q}` : '') + location.hash);
    $$('[data-keep-query]').forEach((a) => {
      const url = new URL((a as HTMLAnchorElement).href);
      url.search = q;
      (a as HTMLAnchorElement).href = url.toString();
    });
  }

  function render() {
    const res = compare({ ...data, ...state });
    state.op = res.op;
    $('[data-results]').innerHTML = renderResults(res);
    const cur = res.dest.fcfa;
    $('[data-count]').textContent = `Voir les ${res.total} offres`;
    const hasBest = res.best && res.amount > 0;
    $('[data-best]').textContent = hasBest ? `jusqu'à ${fmt(res.best.received)} ${cur} reçus` : res.amount > 0 ? 'aucune offre pour ce choix' : 'saisissez un montant';
    $('[data-heading]').textContent = $('[data-heading]').textContent!.replace(/·[^·]*$/, `· ${fmt(res.amount)} ${res.ccy}`);
    const excluded = res.excluded ? ` · ${res.excluded} exclu${res.excluded > 1 ? 's' : ''} (frais supérieurs au montant)` : '';
    $('[data-meta]').textContent = `${res.total} services · ${res.op === 'all' ? 'tous portefeuilles' : OPS[res.op]} · ${res.kind === 'first' ? 'premier envoi' : 'envoi habituel'}${excluded}`;
    $('[data-status]').textContent = hasBest
      ? `${res.total} offres. Meilleur montant reçu : ${fmt(res.best.received)} ${cur} avec ${res.best.provider.name}.`
      : res.amount > 0 ? 'Aucune offre pour ce choix.' : 'Saisissez un montant.';
    $$('[data-op]').forEach((b) => {
      const n = Number(b.querySelector('small')?.textContent);
      (b as HTMLButtonElement).disabled = b.dataset.op !== 'all' && n === 0;
    });
    $$('[data-quick]').forEach((b) => b.setAttribute('aria-pressed', String(Number(b.dataset.quick) === res.amount)));
    $$('[data-op]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.op === res.op)));
    $$('[data-kind]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.kind === res.kind)));
    $$('[data-sort]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.sort === res.sort)));
    syncUrl();
  }

  amountInput.value = String(state.amount);
  amountInput.addEventListener('input', () => { state.amount = Math.max(0, Number(amountInput.value) || 0); render(); });
  $$('[data-quick]').forEach((b) => b.addEventListener('click', () => { state.amount = Number(b.dataset.quick); amountInput.value = String(state.amount); render(); }));
  $$('[data-op]').forEach((b) => b.addEventListener('click', () => { state.op = b.dataset.op!; render(); }));
  $$('[data-kind]').forEach((b) => b.addEventListener('click', () => { state.kind = b.dataset.kind!; render(); }));
  $$('[data-sort]').forEach((b) => b.addEventListener('click', () => { state.sort = b.dataset.sort!; render(); }));
  $('[data-results]').addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('[data-toggle-kind]')) { state.kind = state.kind === 'first' ? 'usual' : 'first'; render(); }
  });
  $<HTMLSelectElement>('[data-from]').addEventListener('change', (e) => {
    const q = location.search;
    location.assign((e.target as HTMLSelectElement).value + q);
  });
  render();
</script>
