---
// Polices servies par le site lui-même (aucune requête vers Google Fonts).
import '@fontsource-variable/outfit/wght.css';
import '@fontsource-variable/dm-sans/wght.css';
import '@fontsource-variable/space-grotesk/wght.css'; // réservée au mot « nia » du logo
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import quotes from '../data/quotes.json';

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const analyticsDomain = import.meta.env.PUBLIC_PLAUSIBLE_DOMAIN;
---
<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{title}</title>
  <meta name="description" content={description}>
  <link rel="canonical" href={canonical}>
  <meta property="og:type" content="website">
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={canonical}>
  <meta property="og:locale" content="fr_FR">
  <meta name="theme-color" content="#5B3DD6">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  {analyticsDomain && <script defer data-domain={analyticsDomain} src="https://plausible.io/js/script.js"></script>}
</head>
<body>
  <svg width="0" height="0" style="position:absolute" aria-hidden="true">
    <symbol id="nia-mark" viewBox="254 251 292 347">
      <path d="M291.5 468V393a108.5 108.5 0 0 1 217 0v17" fill="none" stroke="currentColor" stroke-width="67" stroke-linecap="round"></path>
      <circle cx="291.5" cy="560" r="37.5" fill="currentColor"></circle>
      <circle cx="508.5" cy="560" r="37.5" fill="currentColor"></circle>
    </symbol>
  </svg>
  {quotes.sample && (
    <div class="sample-banner" role="note">Démonstration : les taux des services affichés sont des données d'exemple, pas des offres réelles.</div>
  )}
  <Header>
    <slot name="hero" />
  </Header>
  <main id="contenu">
    <slot />
  </main>
  <Footer />
</body>
</html>
