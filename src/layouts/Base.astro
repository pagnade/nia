---
// Polices servies par le site lui-même (aucune requête vers Google Fonts).
import '@fontsource-variable/outfit/wght.css';
import '@fontsource-variable/dm-sans/wght.css';
import '@fontsource-variable/space-grotesk/wght.css'; // réservée au mot « nia » du logo
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import quotes from '../data/quotes.json';
import { T } from '../lib/i18n.js';

interface Props {
  title: string;
  description: string;
  /** Page comparateur : les liens du menu pointent vers ses propres sections. */
  localAnchors?: boolean;
  /** Données structurées schema.org (JSON-LD). */
  jsonLd?: object;
  lang?: 'fr' | 'en';
  /** Même page dans chaque langue (chemins), pour hreflang et le sélecteur de langue. */
  alternates?: { fr: string; en: string };
}
const { title, description, localAnchors = false, jsonLd, lang = 'fr', alternates } = Astro.props;
const t = T[lang];
const absUrl = (p: string) => (Astro.site ? new URL(p, Astro.site).href : null);
// Tant que les relevés sont des exemples, on demande aux moteurs de ne pas indexer : pas de faux taux dans Google.
const noindex = quotes.sample;
// Pas d'URL canonique tant que SITE_URL n'est pas définie : une fausse adresse ferait plus de mal que rien.
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : null;
const analyticsDomain = import.meta.env.PUBLIC_PLAUSIBLE_DOMAIN;
---
<!doctype html>
<html lang={t.htmlLang}>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{title}</title>
  <meta name="description" content={description}>
  {noindex && <meta name="robots" content="noindex, follow">}
  {canonical && <link rel="canonical" href={canonical}>}
  {Astro.site && alternates && <>
    <link rel="alternate" hreflang="fr" href={absUrl(alternates.fr)}>
    <link rel="alternate" hreflang="en" href={absUrl(alternates.en)}>
    <link rel="alternate" hreflang="x-default" href={absUrl(alternates.fr)}>
  </>}
  <meta property="og:type" content="website">
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  {canonical && <meta property="og:url" content={canonical}>}
  <meta property="og:locale" content={t.ogLocale}>
  <meta name="theme-color" content="#5B3DD6">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>}
  {analyticsDomain && <script defer data-domain={analyticsDomain} src="https://plausible.io/js/script.js"></script>}
</head>
<body>
  <svg width="0" height="0" style="position:absolute" aria-hidden="true">
    <symbol id="nia-mark" viewBox="254 251 292 347">
      <path d="M291.5 468V393a108.5 108.5 0 0 1 217 0v17" fill="none" stroke="currentColor" stroke-width="67" stroke-linecap="round"></path>
      <circle cx="291.5" cy="560" r="37.5" fill="currentColor"></circle>
      <circle cx="508.5" cy="560" r="37.5" fill="currentColor"></circle>
    </symbol>
  </svg>
  {quotes.sample && (
    <aside class="sample-banner" aria-label={t.sampleBannerLabel}>{t.sampleBanner}</aside>
  )}
  <Header localAnchors={localAnchors} lang={lang} switchHref={alternates ? alternates[lang === 'fr' ? 'en' : 'fr'] : null}>
    <slot name="hero" />
  </Header>
  <main id="contenu">
    <slot />
  </main>
  <Footer localAnchors={localAnchors} lang={lang} />
</body>
</html>
